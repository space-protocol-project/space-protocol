{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "space.client.lifecycle.p1"
    },
    "device": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "local_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "installation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "instance": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "state": {
      "enum": [
        "absent",
        "disabled",
        "enabled",
        "draining",
        "updating",
        "ready",
        "quarantined",
        "removed"
      ]
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483646
    },
    "package_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "data_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "data_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "grant_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483646
    },
    "plan": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "source": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "target": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "schema_from": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "schema_to": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "data_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "checkpoint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "steps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            }
          },
          "required": [
            "plan_id",
            "source",
            "target",
            "schema_from",
            "schema_to",
            "data_revision",
            "checkpoint",
            "steps"
          ]
        }
      ]
    },
    "step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "staged_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "history": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      }
    },
    "data_present": {
      "type": "boolean"
    }
  },
  "required": [
    "format",
    "device",
    "local_profile",
    "installation",
    "instance",
    "state",
    "generation",
    "revision",
    "package_digest",
    "schema",
    "data_digest",
    "data_revision",
    "grant_epoch",
    "plan",
    "step",
    "staged_digest",
    "history",
    "data_present"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
