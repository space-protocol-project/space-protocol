{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "space.client.catalog-event.p1"
        },
        "device": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "local_profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "installation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "instance": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "package_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "grant_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        },
        "root_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        },
        "kind": {
          "const": "page"
        },
        "snapshot": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "entries": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "handle": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "pattern": "^[^/\\\\\\u0000-\\u001f\\u007f]+$"
              },
              "type": {
                "enum": [
                  "file",
                  "directory"
                ]
              }
            },
            "required": [
              "handle",
              "name",
              "type"
            ]
          }
        },
        "next_cursor": {
          "type": "string",
          "pattern": "^([0-9a-f]{32})?$"
        },
        "more": {
          "type": "boolean"
        }
      },
      "required": [
        "format",
        "device",
        "local_profile",
        "installation",
        "instance",
        "package_digest",
        "generation",
        "grant_id",
        "grant_revision",
        "root_id",
        "request_id",
        "sequence",
        "kind",
        "snapshot",
        "entries",
        "next_cursor",
        "more"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "more": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "next_cursor": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "entries": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "next_cursor": {
                "const": ""
              }
            }
          }
        }
      ]
    },
