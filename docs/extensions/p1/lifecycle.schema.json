                "maximum": 2147483646
              },
              "expected_revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483646
              },
              "active": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              },
              "authorized": {
                "type": "boolean"
              },
              "package_verified": {
                "type": "boolean"
              },
              "compatible": {
                "type": "boolean"
              },
              "grants_approved": {
                "type": "boolean"
              },
              "backup_ready": {
                "type": "boolean"
              },
              "migration_ready": {
                "type": "boolean"
              }
            }
          },
          "expected": {
