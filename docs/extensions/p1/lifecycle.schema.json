            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "state",
              "action",
              "actor",
              "revision",
              "expected_revision",
              "active",
              "authorized",
              "package_verified",
              "compatible",
              "grants_approved",
              "backup_ready",
              "migration_ready"
