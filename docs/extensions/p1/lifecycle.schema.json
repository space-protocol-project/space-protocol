              },
              "action": {
                "enum": [
                  "verify",
                  "install",
                  "enable",
                  "disable",
                  "finish_disable",
                  "begin_upgrade",
                  "finish_upgrade",
                  "fail_upgrade",
                  "quarantine",
                  "recover",
                  "remove"
                ]
              },
              "actor": {
                "enum": [
                  "owner",
                  "system"
                ]
              },
              "revision": {
                "type": "integer",
