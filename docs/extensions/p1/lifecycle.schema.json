              },
              "state": {
                "enum": [
                  "staged",
                  "verified",
                  "installed",
                  "enabled",
                  "disabling",
                  "disabled",
                  "upgrading",
                  "failed",
                  "quarantined",
                  "removed"
                ]
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483646
              },
              "admission": {
                "type": "boolean"
              },
              "cancel_active": {
                "type": "boolean"
              },
              "preserve_data": {
                "const": true
              }
