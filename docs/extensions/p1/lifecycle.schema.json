                "const": "space.lifecycle.p1"
              },
              "state": {
                "enum": [
                  "staged",
                  "verified",
                  "installed",
                  "enabled",
                  "disabling",
                  "disabled",
                  "upgrading",
                  "failed",
                  "quarantined",
                  "removed"
