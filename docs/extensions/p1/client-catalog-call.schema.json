{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "space.client.catalog-call.p1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "space.client.catalog.p1"
        },
        "device": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "local_profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "installation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "instance": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "maxLength": 64
        },
        "package_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "grant_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483646
        },
        "root_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "operation": {
          "enum": [
            "list",
            "read"
          ]
        },
        "handle": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "cursor": {
          "type": "string",
          "pattern": "^([0-9a-f]{32})?$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      },
      "required": [
        "format",
        "device",
        "local_profile",
        "installation",
        "instance",
        "package_digest",
        "generation",
        "grant_id",
        "grant_revision",
        "root_id",
        "operation",
        "handle",
        "cursor",
        "offset",
        "limit"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "list"
              }
            }
          },
          "then": {
            "properties": {
              "limit": {
                "maximum": 128
              },
              "offset": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "read"
              }
            }
          },
          "then": {
            "properties": {
              "cursor": {
                "const": ""
              }
            }
          }
        }
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    }
  },
  "required": [
    "format",
    "request_id",
    "request"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
