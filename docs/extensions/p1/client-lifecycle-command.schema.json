{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "space.client.lifecycle-command.p1"
    },
    "device": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "local_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "installation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "instance": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483646
    },
    "action": {
      "enum": [
        "install",
        "enable",
        "disable",
        "drained",
        "prepare",
        "advance",
        "publish",
        "abort",
        "quarantine",
        "recover",
        "remove",
        "purge",
        "reopen",
        "restore"
      ]
    },
    "plan": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "source": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "target": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "schema_from": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "schema_to": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "data_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "checkpoint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "steps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            }
          },
          "required": [
            "plan_id",
            "source",
            "target",
            "schema_from",
            "schema_to",
            "data_revision",
            "checkpoint",
            "steps"
          ]
        }
      ]
    }
  },
  "required": [
    "format",
    "device",
    "local_profile",
    "installation",
    "instance",
    "generation",
    "expected_revision",
    "action",
    "plan"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
