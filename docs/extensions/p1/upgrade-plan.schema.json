{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "space",
    "installation",
    "generation",
    "revision",
    "data_revision",
    "source",
    "target",
    "grants",
    "schema_from",
    "schema_to",
    "steps",
    "checkpoint"
  ],
  "properties": {
    "version": {
      "const": "space.upgrade.p1"
    },
    "space": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "installation": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483644
    },
    "data_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "grants": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_from": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "schema_to": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "steps": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "from": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "to": {
            "type": "integer",
            "minimum": 2,
            "maximum": 65535
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "checkpoint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
