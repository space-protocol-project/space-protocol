{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "space.client.grant.p1"
    },
    "device": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "local_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "installation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "instance": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "package_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "grant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "grant_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483646
    },
    "capability": {
      "const": "device.catalog.read"
    },
    "root_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "state": {
      "enum": [
        "active",
        "revoked"
      ]
    },
    "access": {
      "const": "read"
    },
    "origin": {
      "const": "local_user"
    }
  },
  "required": [
    "format",
    "device",
    "local_profile",
    "installation",
    "instance",
    "package_digest",
    "generation",
    "grant_id",
    "grant_revision",
    "capability",
    "root_id",
    "state",
    "access",
    "origin"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
