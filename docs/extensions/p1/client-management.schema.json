{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "device": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "local_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "installation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "instance": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "package_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "format": {
      "const": "space.client.management.p1"
    },
    "action": {
      "enum": [
        "grant",
        "revoke",
        "disable",
        "remove"
      ]
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483646
    }
  },
  "required": [
    "device",
    "local_profile",
    "installation",
    "instance",
    "package_digest",
    "generation",
    "format",
    "action",
    "expected_revision"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
