{
  "format": "space.package-profile.p1",
  "plugin_id": "org.example.polls",
  "version": "0.1.0",
  "profile": "hybrid",
  "modules": {
    "client": {
      "entrypoint": "client.wasm",
      "host_api": "space.client.p1",
      "wasm_abi": "space_client_p1",
      "data_schema": 1,
      "permissions": [
        "storage.instance",
        "device.catalog.read",
        "ui.contribute"
      ],
      "platforms": [
        "windows"
      ]
    },
    "server": {
      "entrypoint": "server.wasm",
      "host_api": "space.plugin.p1",
      "wasm_abi": "space_plugin_p1",
      "data_schema": 1,
      "permissions": [
        "storage.own"
      ],
      "platforms": [
        "server"
      ]
    }
  },
  "contributions": [
    {
      "id": "client.main",
      "owner": "client",
      "surface": "app.navigation",
      "ui_api": "space.ui.p1"
    },
    {
      "id": "server.main",
      "owner": "server",
      "surface": "space.overview",
      "ui_api": "space.ui.p1"
    }
  ],
  "compatibility": {
    "exchange_api": "org.example.polls",
    "revision": 1
  }
}
