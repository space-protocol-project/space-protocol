{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "space.client.installation.p1"
    },
    "device": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "local_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "installation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "instance": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "package_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483646
    },
    "state": {
      "enum": [
        "disabled",
        "enabled",
        "removed"
      ]
    },
    "profile": {
      "enum": [
        "client",
        "hybrid"
      ]
    },
    "requested": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "storage.instance",
          "device.catalog.read",
          "ui.contribute"
        ]
      }
    }
  },
  "required": [
    "format",
    "device",
    "local_profile",
    "installation",
    "instance",
    "package_digest",
    "generation",
    "revision",
    "state",
    "profile",
    "requested"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
