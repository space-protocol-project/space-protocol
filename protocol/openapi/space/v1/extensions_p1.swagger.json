    "v1ChangeExtensionInstallationRequest": {
      "type": "object",
      "properties": {
        "installationId": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "expectedRevision": {
          "type": "string",
          "format": "int64"
        },
