    "v1ExecuteExtensionCommandRequest": {
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "payloadJson": {
          "type": "string",
          "format": "byte"
        },
        "effect": {
          "$ref": "#/definitions/v1ExtensionCommandEffect",
          "description": "Должен совпадать с доверенным описанием команды. Клиент не выдаёт полномочия."
        },
        "idempotencyKey": {
          "type": "string"
        },
        "expectedStateRevision": {
          "type": "string",
          "format": "uint64"
        },
        "historyId": {
          "type": "string",
          "description": "Обязателен для исполнения MUTATION. При повторе менять запрещено.\nДля сверки старой квитанции сохраняется исходное значение, включая пустое v1/v2."
        },
        "retryLeaseId": {
          "type": "string",
          "description": "Неизменная часть команды/digest. Пустое значение не разрешает автоматический повтор."
        }
      }
    },
    "v1ExecuteExtensionCommandResponse": {
      "type": "object",
      "properties": {
        "documentJson": {
          "type": "string",
          "format": "byte"
        },
        "effect": {
          "$ref": "#/definitions/v1ExtensionCommandEffect"
        },
        "stateRevision": {
          "type": "string",
          "format": "uint64"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "v1ExtensionCommandEffect": {
      "type": "string",
      "enum": [
        "EXTENSION_COMMAND_EFFECT_UNSPECIFIED",
        "EXTENSION_COMMAND_EFFECT_NONE",
        "EXTENSION_COMMAND_EFFECT_MUTATION"
      ],
      "default": "EXTENSION_COMMAND_EFFECT_UNSPECIFIED"
    },
    "v1ExtensionCommandOutcome": {
      "type": "string",
      "enum": [
        "EXTENSION_COMMAND_OUTCOME_UNSPECIFIED",
        "EXTENSION_COMMAND_OUTCOME_UNKNOWN",
        "EXTENSION_COMMAND_OUTCOME_CONFIRMED"
      ],
      "default": "EXTENSION_COMMAND_OUTCOME_UNSPECIFIED",
      "description": " - EXTENSION_COMMAND_OUTCOME_UNKNOWN: Квитанция отсутствует; это НЕ доказательство отсутствия эффекта."
    },
    "v1ExtensionInstallation": {
      "type": "object",
      "properties": {
        "installationId": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "format": "int64"
        },
        "generation": {
          "type": "string"
        },
        "bindingSha256": {
          "type": "string",
          "format": "byte"
        }
      },
      "description": "Административный API P1: текущая сессия с space.manage, владелец и manage ACL\nвсех каналов установки. Не устанавливает пакеты и не принимает роль system."
    },
    "v1ExtensionInstallationAuditEntry": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "format": "int64"
        },
        "generation": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "description": "checkpoint, owner, system; назначает только ядро."
        },
        "principalId": {
          "type": "string"
        },
        "previousState": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "description": "RFC3339Nano, UTC."
        }
      }
    },
