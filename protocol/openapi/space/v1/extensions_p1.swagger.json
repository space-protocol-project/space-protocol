    "v1GetExtensionMutationContextRequest": {
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string"
        },
        "requestRetryWindow": {
          "type": "boolean",
          "description": "Только перед новой командой; повтор не запрашивает новое разрешение."
        }
      },
      "description": "Доверенный контекст получают до первой отправки и сохраняют вместе с командой."
    },
    "v1GetExtensionMutationContextResponse": {
      "type": "object",
      "properties": {
        "historyId": {
          "type": "string",
          "description": "32 строчных шестнадцатеричных символа; меняется при restore, но не restart."
        },
        "retryLeaseId": {
          "type": "string",
          "description": "Короткое разрешение, привязанное к principal, экземпляру и истории.\nНедействительно после перезапуска исполнителя. Не сохранять как новое окно при resume."
        },
        "retryWindowRemainingMs": {
          "type": "string",
          "format": "uint64",
          "description": "30000 мс от выдачи; клиент отсчитывает от начала RPC монотонными часами."
        }
      }
    },
    "v1ListExtensionInstallationAuditRequest": {
      "type": "object",
      "properties": {
        "installationId": {
          "type": "string"
        },
        "generation": {
          "type": "string",
          "description": "Текущее поколение из GetExtensionInstallation."
        },
        "afterRevision": {
          "type": "string",
          "format": "int64"
        },
        "throughRevision": {
          "type": "string",
          "format": "int64",
          "description": "0 на первой странице; далее возвращённая верхняя граница."
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "description": "0 означает 50; допустимо 1..100."
        }
      }
    },
    "v1ListExtensionInstallationAuditResponse": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1ExtensionInstallationAuditEntry"
          }
        },
        "nextAfterRevision": {
          "type": "string",
          "format": "int64",
          "description": "0 означает конец выбранного диапазона."
        },
        "throughRevision": {
          "type": "string",
          "format": "int64"
        },
        "generation": {
          "type": "string"
        }
      }
    },
    "v1ListExtensionInstallationsRequest": {
      "type": "object",
      "properties": {
        "afterInstallationId": {
          "type": "string"
        },
        "pageSize": {
          "type": "integer",
          "format": "int32",
          "description": "0 означает 50; допустимо 1..100."
        },
        "generation": {
          "type": "string",
          "description": "Обязательно при продолжении; смена требует нового чтения."
        }
      }
    },
    "v1ListExtensionInstallationsResponse": {
      "type": "object",
      "properties": {
        "installations": {
          "type": "array",
          "items": {
