            "$ref": "#/definitions/v1ExtensionInstallation"
          }
        },
        "nextAfterInstallationId": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        }
      }
    },
    "v1QueryExtensionRequest": {
      "type": "object",
      "properties": {
        "instanceId": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "payloadJson": {
          "type": "string",
          "format": "byte",
          "description": "UTF-8 JSON, не больше 16 КиБ; context задаёт только ядро."
        }
      }
    },
    "v1QueryExtensionResponse": {
      "type": "object",
      "properties": {
        "documentJson": {
          "type": "string",
          "format": "byte"
        },
        "uiApi": {
          "type": "string"
        }
      }
    },
    "v1ReconcileExtensionCommandRequest": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "#/definitions/v1ExecuteExtensionCommandRequest"
        }
      },
      "description": "Проверяет точный исходный запрос, не исполняя команду и не вызывая WASM."
    },
    "v1ReconcileExtensionCommandResponse": {
      "type": "object",
      "properties": {
        "outcome": {
          "$ref": "#/definitions/v1ExtensionCommandOutcome"
        },
        "receipt": {
          "$ref": "#/definitions/v1ExecuteExtensionCommandResponse",
          "description": "Только для CONFIRMED; выдача требует текущих прав исполнения команды."
        },
        "retryWindowKnown": {
          "type": "boolean",
          "description": "Сверка возвращает false/0 и не открывает окно заново. Короткое окно выдаёт контекст новой команды.\nUNKNOWN никогда не разрешает повторную отправку сам по себе."
        },
        "retryWindowRemainingMs": {
          "type": "string",
          "format": "uint64"
        }
      }
    }
